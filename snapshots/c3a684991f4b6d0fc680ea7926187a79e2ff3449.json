{"page_no":8,"page_sha1":"5e2712be6e8218e0fed44713d2c48627d4121d02","source":"llm_vision","model_id":"gemini-3.5-flash","prompt_version":"v1-36067a6a","schema_version":"1.0.0","blocks":[{"id":"p96-b00","type":"page_number","page_no":8,"order":0,"bbox":null,"column":0,"text":"96","text_source":"ocr","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p96-b01","type":"running_head","page_no":8,"order":1,"bbox":null,"column":0,"text":"Woojin Jeong, Woncheol Jang","text_source":"ocr","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p96-b02","type":"figure","page_no":8,"order":2,"bbox":null,"column":0,"text":"Figure 4: Histogram of the number of first prize winners in each simulation for F = {1, 2, . . . , M}. For visualization purposes, the range of the x-axis was restricted to 1 to 150. Additionally, there were 0, 7, and 21 extreme values above 150 for M = 25 and w = (1/4, 3/8, 1/2), respectively.","text_source":"llm","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":"M과 w의 변화에 따른 1등 당첨자 수의 시뮬레이션 히스토그램","alt_long":"가로축은 1등 당첨자 수(1부터 150까지), 세로축은 확률 밀도(Probability Density)를 나타낸다. M과 w의 값(w = 1/4, 3/8, 1/2 및 M = 25, 30, 35)에 따른 9개의 히스토그램 서브플롯으로 구성되어 있다.","figure_kind":"bar","crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":0.9,"flags":[],"note":null},{"id":"p96-b03","type":"paragraph","page_no":8,"order":3,"bbox":null,"column":0,"text":"발권), 나머지 1/3은 자동발권이라고 생각하므로 랜덤샘플링을 한다. 여기서 B와 p의 값은 실제 대한민국 6/45 로또 추첨에서의 값에 가깝게 설정한 것이다.","text_source":"ocr","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p96-b04","type":"paragraph","page_no":8,"order":4,"bbox":null,"column":0,"text":"4. 회차별로(D = 1000), w와 F, M를 바꿔가면서 1등 당첨자의 수를 조사하자.","text_source":"ocr","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p96-b05","type":"paragraph","page_no":8,"order":5,"bbox":null,"column":0,"text":"Figure 4 은 각 시뮬레이션에서 1등 당첨자 수를 서로 다른 M과 w에 대하여 히스토그램으로 나타낸 것이고, Table 4 은 각 시뮬레이션에서 1등 당첨자 수의 평균과 분산을 나타낸 것이다. 만약 구매자들이 특정번호에 대한 선호현상이 없다면 평균과 분산은 모두 12.28일 것으로 기대된다.","text_source":"ocr","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p96-b06","type":"paragraph","page_no":8,"order":6,"bbox":null,"column":0,"text":"이를 보면, w와 M에 상관없이 1등 당첨자 수의 기대값은 큰 차이가으나, w가 커질수록 1등 당첨자 수의 분포는 좌우로 넓게 퍼진, 즉 분산이 커진 형태를 띔을 확인할 수 있다. 이는 실제 복권 추첨 상황에서 1등 당첨자 수가 불규칙하게 나오는 현상을 설명한다. 히스토그램 상으로 확인해보면, w가 커지면 극단적인","text_source":"ocr","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":true,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null}],"terms":[{"id":"p96-t00","type":"term","page_no":8,"order":0,"bbox":null,"column":null,"text":"","text_source":"llm","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,