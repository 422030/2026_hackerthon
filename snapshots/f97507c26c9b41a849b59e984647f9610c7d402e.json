,"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p3-b03","type":"table","page_no":3,"order":3,"bbox":null,"column":0,"text":"","text_source":"llm","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":"시나리오명, 시나리오 코드, APT 그룹 정보 및 공격 상세 내용을 정리한 개요 표","alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":[[{"text":"항목","is_header":true,"header_axis":"col","row_span":1,"col_span":1,"footnote_markers":[]},{"text":"내용","is_header":true,"header_axis":"col","row_span":1,"col_span":1,"footnote_markers":[]}],[{"text":"시나리오 명","is_header":true,"header_axis":"row","row_span":1,"col_span":1,"footnote_markers":[]},{"text":"Apache ActiveMQ 취약점(CVE-2023-46604)을 이용한 Mauri 랜섬웨어 공격","is_header":false,"header_axis":"none","row_span":1,"col_span":1,"footnote_markers":[]}],[{"text":"시나리오 코드","is_header":true,"header_axis":"row","row_span":1,"col_span":1,"footnote_markers":[]},{"text":"SN0185F","is_header":false,"header_axis":"none","row_span":1,"col_span":1,"footnote_markers":[]}],[{"text":"APT 그룹 명","is_header":true,"header_axis":"row","row_span":1,"col_span":1,"footnote_markers":[]},{"text":"미식별 그룹","is_header":false,"header_axis":"none","row_span":1,"col_span":1,"footnote_markers":[]}],[{"text":"APT 그룹 설명","is_header":true,"header_axis":"row","row_span":1,"col_span":1,"footnote_markers":[]},{"text":"-","is_header":false,"header_axis":"none","row_span":1,"col_span":1,"footnote_markers":[]}],[{"text":"공격 발생 시기","is_header":true,"header_axis":"row","row_span":1,"col_span":1,"footnote_markers":[]},{"text":"","is_header":false,"header_axis":"none","row_span":1,"col_span":1,"footnote_markers":[]}],[{"text":"공격 내용","is_header":true,"header_axis":"row","row_span":1,"col_span":1,"footnote_markers":[]},{"text":"공격자는 Apache ActiveMQ의 Java OpenWire 프로토콜 역직렬화 취약점(CVE-2023-46604)을 악용하여 원격 시스템에서 임의의 셸 명령을 실행한다. 이 과정에서 공격자는 OpenWire 프로토콜의 직렬화된 클래스 타입을 조작하고, 원격 서버에서 악성 XML 설정 파일을 로드하여 `ProcessBuilder`를 통해 명령을 실행하여 초기 침투를 완료한다.\n\n초기 침투에 성공한 공격자는 `net user` 명령어를 통해 백도어 로컬 계정을 생성한다. 이어서 `net localgroup administrators` 명령어를 사용하여 새로 생성된 계정을 관리자 그룹에 추가함으로써 시스템에 대한 지속적인 관리자 권한 접근을 확보한다.\n\n이후 공격자는 C2 서버로 HTTP 요청을 보내 Fast Reverse Proxy(FRP) 클라이언트 실행 파일인 `frpc.exe`를 임시 경로에 다운로드한다. 이 도구는 방화벽이나 NAT 뒤에 있는 내부 시스템을 외부에 노출시키기 위한 터널링 기능을 설정하는 데 활용된다.\n\n연이어 공격자는 HTTP GET 요청을 통해 C2 서버로부터 Mauri 랜섬웨어의 핵심 파일인 `ransomware.exe`와 `unlocker.exe`를 다운로드하여 임시 폴더에 저장한다. Mauri 랜섬웨어는 AES-256-CTR 암호화를 사용하는 오픈소스 기반 랜섬웨어이다.\n\n최종적으로 공격자는 다운로드된 `ransomware.exe`를 실행하여 시스템 내 중요 파일을 AES-256-CTR 암호화 알고리즘으로 암호화한다. 암호화된 파일에는 `.locked` 확장자가 추가되며, 이는 데이터 가용성을 차단하고 피해자에게 몸값을 요구하기 위한 행위이다.","is_header":false,"header_axis":"none","row_span":1,"col_span":1,"footnote_markers":[]}]],"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p3-b04","type":"page_number","page_no":3,"order":4,"bbox":null,"column":0,"text":"- 3 -","text_source":"ocr","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null}],"terms":[{"id":"p3-t00","type":"term","page_no":3,"order":0,"bbox":null,"column":null,"text":"","text_source":"llm","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_fro