rmula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b03","type":"paragraph","page_no":5,"order":3,"bbox":null,"column":0,"text":"먼저 복권의 추첨 결과가 완전히 랜덤한지 확인하기 위해, 1부터 45까지의 숫자 혹은 임의의 두 수의 쌍이 역대 당첨번호에서 당첨된 빈도에 대한 균등분포의 적합도 검정 방법론을 소개한다. 본 논문에서는 Joe (1993)과 Genest 등 (2002)이 제시한 피어슨 카이제곱 통계량의 점근적 분포를 이용한 검정과 bootstrap 검정을 수행하였다.","text_source":"mixed","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b04","type":"heading","page_no":5,"order":4,"bbox":null,"column":0,"text":"2.1. 피어슨 카이제곱 통계량의 점근 근사이론을 이용한 검정","text_source":"mixed","level":2,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b05","type":"paragraph","page_no":5,"order":5,"bbox":null,"column":0,"text":"총 D회차의 k/N 로또 추첨에서 각 번호가 뽑힐 확률이 동일한지 여부에 관한 적합도 검정의 검정통계량은 다음과 같이 주어진다.","text_source":"mixed","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b06","type":"formula","page_no":5,"order":6,"bbox":null,"column":0,"text":"","text_source":"llm","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":"\\chi_1^2 = \\sum_{i=1}^N \\frac{(O_i - E_i)^2}{E_i},","speech":"카이제곱 일 은 시그마 아이는 일부터 엔까지, 이 아이 분의 괄호 열고 오 아이 빼기 이 아이 괄호 닫고 제곱","formula_label":"(2.1)","marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b07","type":"paragraph","page_no":5,"order":7,"bbox":null,"column":0,"text":"여기서 O_i는 i번째 번호가 D회차 동안 관측된 횟수이며, E_i은 k/N 로또에서 i번째 번호가 D회차 동안 나타날 기대횟수를 나타낸다.","text_source":"mixed","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b08","type":"paragraph","page_no":5,"order":8,"bbox":null,"column":0,"text":"일반적으로 위의 검정통계량 (2.1)은 자유도가 N - 1인 \\chi^2분포를 따른다. 하지만 복권추첨의 경우, 한 회차 내에서 각 숫자는 비복원추출 되므로 위의 점근분포를 그대로 사용할 수 없다. Joe (1993)은, 다음의 수정된 카이제곱 통계량을 제시하고 이 수정된 통계량의 점근분포가 \\chi_{N-1}^2를 따르는 것을 증명하였다.","text_source":"mixed","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b09","type":"formula","page_no":5,"order":9,"bbox":null,"column":0,"text":"","text_source":"llm","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":"\\chi_{1,adj}^2 = \\frac{(N-1)}{(N-k)} \\chi_1^2 \\sim \\chi^2(N-1).","speech":"카이제곱 일 아래첨자 에이디제이는 엔 빼기 케이 분의 엔 빼기 일 곱하기 카이제곱 일 이며 이는 자유도 엔 빼기 일인 카이제곱 분포를 따른다","formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b10","type":"paragraph","page_no":5,"order":10,"bbox":null,"column":0,"text":"각 숫자의 출현빈도의 균등분포에 관한 적합성 검정에 추가로 Genest 등 (2002)은, 각 회차에서 숫자 쌍 {i, j}, 1 \\le i < j \\le N의 출현빈도가 균등분포인지 여부에 대한 검정을 제안하였다. 우선 O_{\\{i,j\\}}가 두 숫자 i, j가 동시에 추첨된 회차들의 횟수, E_{\\{i,j\\}}가 균등분포 가정 하에서 기대도수라고 하자. 이 경우 검정통계량은 다음과 같이 주어진다.","text_source":"mixed","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b11","type":"formula","page_no":5,"order":11,"bbox":null,"column":0,"text":"","text_source":"llm","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":"\\chi_2^2 = \\sum_{i=1}^N \\sum_{j=i+1}^N \\frac{(O_{\\{i,j\\}} - E_{\\{i,j\\}})^2}{E_{\\{i,j\\}}}","speech":"카이제곱 이는 시그마 아이는 일부터 엔까지, 시그마 제이는 아이 플러스 일부터 엔까지, 이 아이 제이 분의 괄호 열고 오 아이 제이 빼기 이 아이 제이 괄호 닫고 제곱","formula_label":"(2.2)","marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b12","type":"paragraph","page_no":5,"order":12,"bbox":null,"column":0,"text":"이 때 균등분포 가정하에서 기대도수는 다음과 같이 계산할 수 있다.","text_source":"mixed","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b13","type":"formula","page_no":5,"order":13,"bbox":null,"column":0,"text":"","text_source":"llm","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":"E_{\\{i,j\\}} = D \\binom{N-2}{k-2} / \\binom{N}{k}.","speech":"이 아이 제이는 디 곱하기 엔 빼기 이 조합 케이 빼기 이 나누기 엔 조합 케이","formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b14","type":"paragraph","page_no":5,"order":14,"bbox":null,"column":0,"text":"Genest 등 (2002)은 \\chi_2^2 (2.2)가 점근적으로 다음과 같은 분포를 따름을 증명하였다.","text_source":"mixed","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b15","type":"formula","page_no":5,"order":15,"bbox":null,"column":0,"text":"","text_source":"llm","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":"\\chi_2^2 \\sim w_1 \\chi_{N-1}^2 + w_2 \\chi_{N(N-3)/2}^2,","speech":"카이제곱 이는 더블유 일 곱하기 카이제곱 엔 빼기 일 플러스 더블유 이 곱하기 카이제곱 이 분의 엔 괄호 열고 엔 빼기 삼 괄호 닫고 분포를 따른다","formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b16","type":"paragraph","page_no":5,"order":16,"bbox":null,"column":0,"text":"여기서","text_source":"ocr","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b17","type":"formula","page_no":5,"order":17,"bbox":null,"column":0,"text":"","text_source":"llm","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":"w_1 = (k-1) \\binom{N-3}{k-2} / \\binom{N-2}{k-2}, \\quad w_2 = \\binom{N-4}{k-2} / \\binom{N-2}{k-2}.","speech":"더블유 일은 괄호 열고 케이 빼기 일 괄호 닫고 곱하기 엔 빼기 삼 조합 케이 빼기 이 나누기 엔 빼기 이 조합 케이 빼기 이, 더블유 이는 엔 빼기 사 조합 케이 빼기 이 나누기 엔 빼기 이 조합 케이 빼기 이","formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b18","type":"paragraph","page_no":5,"order":18,"bbox":null,"column":0,"text":"이 때, \\chi_2^2에 대한 p-값을 구하기 위해서, (2.2)의 점근적 분포를 S = a + b \\chi_{\\nu}^2로 근사한 후 a와 b의 값을 구하기 위해 moment-matching approximation을 사용한다. 즉","text_source":"mixed","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p93-b19","type":"formula","page_no":5,"order":19,"bbox":null,"column":0,"text":"","text_source":"llm","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":"a = \\sum_{i=1}^2 w_i \\nu_i - b \\nu, \\quad b = \\sum_{i=1}^2 w_i^3 \\nu_i / \\sum_{i=1}^2 w_i^2 \\nu_i,","speech":"에이는 시그마 아이는 일부터 이까지 더블유 아이 뉴 아이 빼기 비 뉴, 비는 시그마 아이는 일부터 이까지 더블유 아이 세제곱 뉴 아이 나누기 시그마 아이는 일부터 이까지 더블유 아이 제곱 뉴 아이","formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null}],"terms":[{"id":"p93-t00","type":"term","page_no":5,"order":0,"bbox":null,"column":null,"text":"","text_source":"llm","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":"bootstrap","reading":"부트스트랩","gloss":"표본데이터로부터 재표본 추출을 반복하여 통계량의 표본분포를 추정하는 데이터 기반 방법.","lang":"en","confidence":1.0,"flags":[],"note":null},{"id":"p93-t01","type":"term","page_no":5,"order":1,"bbox":null,"column":null,"text":"","text_source":"llm","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":fa