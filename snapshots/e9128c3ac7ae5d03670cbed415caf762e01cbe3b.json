:1,"footnote_markers":[]},{"text":"1/2","is_header":false,"header_axis":"none","row_span":1,"col_span":1,"footnote_markers":[]},{"text":"13.97","is_header":false,"header_axis":"none","row_span":1,"col_span":1,"footnote_markers":[]},{"text":"64.53","is_header":false,"header_axis":"none","row_span":1,"col_span":1,"footnote_markers":[]}]],"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p97-b06","type":"paragraph","page_no":9,"order":6,"bbox":null,"column":0,"text":"이상점들이 관측되는 것을 볼 수 있다. 이러한 이상점들은 동행복권 1128회차와 같이 이례적으로 1등 당첨자 수가 많게 발생했던 회차에 대응된다.","text_source":"mixed","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p97-b07","type":"paragraph","page_no":9,"order":7,"bbox":null,"column":0,"text":"이제 위의 표본분포가 선호하는 번호와 관련이 없다는 것을 보이기 위해 앞의 시뮬레이션의 Step 1에서 F = {46 - M, 47 - M, ..., 45}라고 하자. Figure 5는 이 경우의 1등 당첨자의 표본분포를 보여주고 있으며 앞의 경우와 비슷한 형태를 보여주고 있다. 즉 선호하는 번호자체는 1등 당첨자 수의 분포에 영향을 미치지 않는다는 것을 알 수 있다.","text_source":"mixed","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p97-b08","type":"paragraph","page_no":9,"order":8,"bbox":null,"column":0,"text":"마지막으로 로또가 공정하지 않다는 가정을 하고 일부 구매자들이 사전정보를 통하여 어떤 번호가 많이 나오는지 알았다고 가정해보자. 즉 이전의 시뮬레이션 절차의 각 단계가 동일하지만, 복권 당첨번호가 p의 확률로 사람들이 선호하는 번호 집단 F에서 추첨되는 새로운 상황을 고려하자. Figure 6는 p = 0.3으로 두고 시행한 시뮬레이션의 1등 당첨자의 표본분포를 보여주고 있으며, Table 5은 이 경우의 평균과 분산을 나타낸 것이다. 이 경우와 Figure 3, Figure 4를 비교해보면, 만약 일부 구매자들이 사전정보를 통하여 어떤 번호가 많이 나올지 아는 상황에서의 1등 당첨자 수 그래프의 개형의 양상은 실제 경우와 다르게, 극단적인 1등 당첨자 수의 비율이 많아지기 때문에 구매자들이 특정번호에 편중된 비율이 커질수록 1등 당첨자들의 분포가 숫자가 작은 부분과 숫자가 큰 부분에서 두 개의 봉우리를 가지는 형태를 가지게 된다. 또한, 그래프의 Table 5를 확인해보면, 각 경우의 평균값이 실제 상황에서 나타나는 1등 당첨자 수의 평균값보다 높게 형성되어 있음 역시 확인 할 수 있다. 따라서 실제 상황과는 많은 차이를 보여주고 있다는 것을 알 수 있다.","text_source":"mixed","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offset":null,"surface":null,"reading":null,"gloss":null,"lang":null,"confidence":1.0,"flags":[],"note":null},{"id":"p97-b09","type":"paragraph","page_no":9,"order":9,"bbox":null,"column":0,"text":"결론적으로, 이는 일부 구매자들이 사전정보를 통하여 특정번호가 많이 나오는지 알고 있다는 가설이 틀림을 암시한다.","text_source":"mixed","level":null,"list_ordered":null,"list_items":[],"starts_mid_sentence":false,"ends_mid_sentence":false,"continues_from":null,"continues_to":null,"alt_short":null,"alt_long":null,"figure_kind":null,"crop_path":null,"table_grid":null,"data_points":[],"latex":null,"speech":null,"formula_label":null,"marker":null,"global_number":null,"footnote_scope":"page","container_block_id":null,"ref_block_ids":[],"ref_char_offs